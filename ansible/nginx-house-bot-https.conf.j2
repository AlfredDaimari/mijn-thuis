# Public TLS edge proxy. The Docker frontend is intentionally reachable only
# through loopback. The API issues sessions; frontend Nginx checks screenshot access.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ house_bot_domain }} _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://{{ house_bot_domain }}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name {{ house_bot_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ house_bot_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ house_bot_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # API errors must remain API errors. In particular, do not turn a
    # temporary upstream failure into the HTML landing page with HTTP 200.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_intercept_errors on;
        error_page 502 503 504 = @landing_page;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Keep the current harmless landing page reachable until the dashboard
    # containers are deployed. Once frontend is running, every request uses it.
    location @landing_page {
        root /srv/house-bot/frontend;
        try_files /index.html =503;
    }
}

# Temporary HTTP configuration used only while Certbot obtains the first
# certificate. It preserves the existing landing page during validation.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ house_bot_domain }} _;

    root /srv/house-bot/frontend;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

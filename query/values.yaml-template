# Copy this file to values.yaml. Do not commit values.yaml.
email: "you@yahoo.com"
password: "your-yahoo-app-password"

# One SQLite database containing the email, listings, and resolved-listings queues.
database: "data/pipeline.sqlite3"

# Used only by the provider-form worker. Keep the real values in the ignored
# values.yaml file. The worker must run with --dry-run until form filling has
# been validated against live provider pages.
applicant:
  first_name: "Your first name"
  last_name: "Your last name"
  phone: "+31..."
  email: "you@example.com"
  # Used for one-room homes, and if the room count cannot be extracted.
  message_single_person: |
    Hello,

    My name is Alfred Daimari and I am very interested in this property. I would appreciate the opportunity to view it, if possible. Please let me know if a viewing can be arranged.

    Thank you for your time.

    Kind regards,
    Alfred Daimari
  # Used for homes with two or more rooms.
  message_two_person: |
    Hello,

    My name is Alfred Daimari, and my partner Chris Benhard and I are very interested in this property. We would appreciate the opportunity to view it, if possible. Please let us know if a viewing can be arranged.

    Thank you for your time.

    Kind regards,
    Alfred Daimari and Chris Benhard

# Optional OpenRouter fallback for unsupported form navigation. This is a secret;
# do not commit it. It is not sent unless deterministic form matching fails.
# OpenRouter only receives the deterministic failure reason and redacted visible
# navigation controls; it never receives applicant values, cookies, or passwords.
openrouter_api_key: ""
openrouter_model: "~openai/gpt-luna-latest"

# Copy the complete Cookie request-header value from a browser session already
# logged into Stekkies. This is an authentication secret, like a password.
stekkies_cookie: "cookie_name=cookie_value; another_cookie=value"

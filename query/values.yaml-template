# Copy this file to values.yaml. Do not commit values.yaml.
email: "you@yahoo.com"
password: "your-yahoo-app-password"

# One SQLite file contains emails, Stekkies links, provider listings, and
# screenshots. Dashboard failure summaries are calculated from source rows.
database: "data/pipeline.sqlite3"

# Credentials for the private observability dashboard. Keep the real values in
# the ignored values.yaml file; they must never be bundled into the frontend or
# returned by the API. The sign-in API uses these to issue a secure session cookie.
frontend_auth:
  username: "change-me"
  password: "change-me"

# Used only by the provider-form worker. Keep the real values in the ignored
# values.yaml file. Production runs with --submit; real names are required.
# Without --submit, the worker records an explicit unsent dry-run result.
applicant:
  first_name: "Your first name"
  last_name: "Your last name"
  phone: "+31..."
  email: "you@example.com"
  # Used for one-room homes, and if the room count cannot be extracted.
  message_single_person: |
    Hello,

    My name is Alfred Daimari and I am very interested in this property. From what I have seen, it appears to meet my financial and space requirements. I would appreciate the opportunity to view it, if possible. Please let me know if a viewing can be arranged.

    Thank you for your time.

    Kind regards,
    Alfred Daimari
  # Used for homes with two or more rooms.
  message_two_person: |
    Hello,

    My name is Alfred Daimari, and my partner Chris Benhard and I are very interested in this property. From what we have seen, it appears to meet our financial and space requirements. We would appreciate the opportunity to view it, if possible. Please let us know if a viewing can be arranged.

    Thank you for your time.

    Kind regards,
    Alfred Daimari and Chris Benhard
  # Non-identifying context used for Dutch provider fields and OpenRouter
  # navigation reasoning. Keep these values aligned with the applicant.
  current_housing_situation: "Huurwoning"
  registered_in_netherlands: true

# Optional OpenRouter fallback for unsupported form navigation. This is a secret;
# do not commit it. It is not sent unless deterministic form matching fails.
# OpenRouter only receives the deterministic failure reason and redacted visible
# navigation controls; it never receives applicant values, cookies, or passwords.
openrouter_api_key: ""
openrouter_model: "openai/gpt-6-luna"

# Copy the complete Cookie request-header value from a browser session already
# logged into Stekkies. This is an authentication secret, like a password.
stekkies_cookie: "cookie_name=cookie_value; another_cookie=value"

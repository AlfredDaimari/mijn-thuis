# Copy to values.yaml. `password` must be a Yahoo app password, not your normal
# Yahoo password. Keep this file private; values.yaml is Git-ignored.
email: "you@yahoo.com"
password: "your-yahoo-app-password"
# One SQLite file holds the email, listings, and resolved-listings queues.
database: "data/pipeline.sqlite3"
# Provider-form profile. Keep the real values in ignored values.yaml.
applicant:
  first_name: "Your first name"
  last_name: "Your last name"
  phone: "+31..."
  email: "you@example.com"
  message: "Hello, I am interested in this property."
# Optional, used only when generic matching cannot find a usable contact form.
# Gemini receives only the failure reason and redacted visible navigation controls.
gemini_api_key: ""
gemini_model: "gemini-2.5-flash"
# Copy the complete Cookie request-header value from a browser session that is
# already logged into Stekkies. This is an authentication secret.
stekkies_cookie: "cookie_name=cookie_value"

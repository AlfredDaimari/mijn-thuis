# Copy this file to terraform.tfvars and replace every placeholder value.
# Do not put OVH API credentials in this file; use the provider's supported
# environment variables. A default payment method is required to order a VPS.
instance_name  = "house-bot"
ovh_subsidiary = "NL"

# Select the current VPS-1 offering (2 vCores, 4 GB RAM, 40 GB NVMe) in the
# OVHcloud Control Panel/catalog and place its exact plan and location values here.
vps_plan_code = "your-vps-1-plan-code"
datacenter    = "your-vps-datacenter-code"
os_name       = "Ubuntu 24.04"

# OVH requires the matching image ID when supplying an SSH public key.
image_id            = "your-ubuntu-image-id"
ssh_public_key_path = "/absolute/path/to/id_ed25519.pub"
